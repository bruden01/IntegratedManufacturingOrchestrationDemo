// Maps a Supplier B tugger fault-channel message (MQTT) to the normalized event: the fault itself (TuggerFault), or Supplier B's report that it moved the loads off the faulted tugger (TuggerReassigned).
package com.vantiqse.imo
import service com.vantiqse.imo.Common

STATELESS PROCEDURE Tugger.normalizeFault(event REQUIRED DESCRIPTION "The tugger Fault event"): Object

var e = Common.unwrap(event)
var t = "TuggerFault"
if (e.type == "TuggerReassigned") {
    t = "TuggerReassigned"
}
var result = {type: t, source: "supplier-b/mqtt", ts: e.ts, detail: {tugger: e.tugger, code: e.code, description: e.description, carrying: e.carrying, moved: e.moved, reason: e.reason}}
return result
