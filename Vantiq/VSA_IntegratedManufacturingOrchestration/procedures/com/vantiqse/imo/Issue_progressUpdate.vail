// Turns a replacement progress event (ReplacementPicked, ReplacementOnTugger, HoldReleased, ReplacementDelivered) into a UI update. When the spare is picked, Vantiq finds and requests a tugger for it. The vehicle's Issue collaboration is completed when the tugger has delivered the replacement, not when the hold is released.
package com.vantiqse.imo

STATELESS PROCEDURE Issue.progressUpdate(event REQUIRED DESCRIPTION "Normalized ReplacementPicked, ReplacementOnTugger, HoldReleased or ReplacementDelivered event"): Object

var kind = event.type
var bin = null
var seq = null
if (event.detail != null) {
    bin = event.detail.bin
    seq = event.detail.seq
}
var summary = "Supplier A released the hold on " + event.vin + ". The replacement is on its way."
var tugger = null
var charger = null
var chargePct = null
var checkedTs = null
var assignedTs = null
var checkSummary = null
if (event.type == "ReplacementPicked") {
    summary = "Supplier A's picker took the replacement from bin " + bin + " for " + event.vin
    var found = Issue.assignTugger(event.vin, seq)
    tugger = found.tugger
    charger = found.charger
    chargePct = found.chargePct
    checkedTs = found.checkedTs
    assignedTs = found.assignedTs
    checkSummary = found.checkSummary
    summary = summary + ". " + found.assignSummary
} else if (event.type == "ReplacementOnTugger") {
    tugger = event.detail.tugger
    summary = "Supplier B assigned the replacement of " + event.vin + " to tugger " + tugger
} else if (event.type == "ReplacementDelivered") {
    tugger = event.detail.tugger
    summary = "Tugger " + tugger + " delivered the replacement for " + event.vin + ". Vantiq closes the case."
    EXECUTE Issue.completeForVehicle(event.vin) WITH partitionKey = event.vin
}

var result = {kind: kind, ts: event.ts, vin: event.vin, seq: seq, bin: bin, summary: summary, tugger: tugger, charger: charger, chargePct: chargePct, checkedTs: checkedTs, assignedTs: assignedTs, checkSummary: checkSummary}
return result
