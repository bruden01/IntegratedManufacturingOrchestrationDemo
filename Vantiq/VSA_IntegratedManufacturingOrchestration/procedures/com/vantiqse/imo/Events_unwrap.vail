// Returns an inbound feed payload as an Object. Accepts the payload as a JSON string, an Object, or a source message that carries the payload in a value property.
package com.vantiqse.imo

STATELESS PROCEDURE Events.unwrap(event REQUIRED DESCRIPTION "The inbound event as the handler received it"): Object

var result = event
if (typeOf(event) == "String") {
    result = parse(event)
}
if (result != null && typeOf(result) == "Object" && result.has("value") && typeOf(result.value) == "Object") {
    result = result.value
}
return result
