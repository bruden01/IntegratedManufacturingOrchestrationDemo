// Entry point for a tugger event from Supplier B. A fault is handled by Fleet.reassign; Supplier B's report that it has moved the loads by Fleet.moved, and that a moved load is on its new tugger by Fleet.loaded.
package com.vantiqse.imo

STATELESS PROCEDURE Fleet.handle(event REQUIRED DESCRIPTION "Normalized TuggerFault, TuggerReassigned or TuggerLoaded event"): Object

var result = null
if (event.type == "TuggerReassigned") {
    result = Fleet.moved(event)
} else if (event.type == "TuggerLoaded") {
    result = Fleet.loaded(event)
} else {
    result = Fleet.reassign(event)
}
return result
