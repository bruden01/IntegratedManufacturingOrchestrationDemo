# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — each developer sets their own.
# ---------------------------------------------------------------------------

# Base URL of your Vantiq server
VITE_VANTIQ_URL=https://dev.vantiq.com

# Your target namespace on the Vantiq server
VITE_VANTIQ_NAMESPACE=VSA_IntegratedManufacturingOrchestration

# ---------------------------------------------------------------------------
# Keycloak / OAuth2
# ---------------------------------------------------------------------------

# Base URL of the Keycloak auth server (typically <vantiq-server>/auth)
VITE_KEYCLOAK_URL=https://dev.vantiq.com/auth

# Keycloak realm (typically matches the server hostname)
VITE_KEYCLOAK_REALM=dev.vantiq.com

# ---------------------------------------------------------------------------
# Deploy to Vantiq web hosting (scripts/deploy.mjs, run via `npm run deploy`,
# or via the vantiq_deploy MCP tool)
# ---------------------------------------------------------------------------

# Bearer token used to upload the built app as Vantiq documents.
# Resolution order: shell env > .env.local > .env > .mcp.json fallback.
# Do NOT prefix with VITE_ — this must never reach the browser bundle.
VANTIQ_TOKEN=your_vantiq_bearer_token_here

# Optional: override the deploy target server (defaults to VITE_VANTIQ_URL)
# VANTIQ_URL=https://dev.vantiq.com

# Optional: Keycloak OIDC client id. Defaults to vantiqPublic (the standard
# Vantiq public client) — override only for a non-standard Keycloak setup.
# VITE_KEYCLOAK_CLIENT_ID=vantiqPublic

# ---------------------------------------------------------------------------
# Production deploys
# ---------------------------------------------------------------------------
# Copy this file to .env.production (gitignored) with production values.
# `vite build --mode vantiq` and the deploy tool both pick it up automatically.
